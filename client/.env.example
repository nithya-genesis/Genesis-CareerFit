# Genesis CareerFit Frontend Environment Variables (Vite)
# API Base URL (leave empty for same-origin proxy in development)
VITE_API_BASE_URL=https://careerfit.genplusconsulting.com

# Supabase Client Authentication (Vite-exposed)
# Replace with your project credentials when connecting to Supabase cloud
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
