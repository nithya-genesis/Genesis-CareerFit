# ==============================================================================
# Genesis CareerFit - Production Environment Configuration Template
# COPY THIS FILE TO .env.production AND FILL IN SECURE VALUES BEFORE DEPLOYMENT
# ==============================================================================

# Application Security (MANDATORY: Generate a 64+ char random hex string in production)
# e.g., openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_FOR_PRODUCTION

# Network & Host Settings
HOST=0.0.0.0
PORT=8000
APP_BASE_URL=https://careerfit.yourdomain.com
CORS_ORIGINS=https://careerfit.yourdomain.com,https://admin.yourdomain.com

# Persistence Storage Paths (Inside Container)
DATABASE_PATH=/data/genesis_careerfit.db
OUTPUTS_DIR=/data/outputs
CHROME_PATH=/usr/bin/chromium

# Transactional Email Settings (Optional)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASSWORD=your_secure_smtp_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Genesis CareerFit
SMTP_USE_TLS=true

# Optional AI Enrichment Gateways (Optional)
GROQ_API_KEY=
NVIDIA_API_KEY=
